{{! Spellcasting Configuration }}
<h3 class="form-header">{{localize "PF1-Psionics.Class.ManifestingHeader"}}</h3>

{{#if @root.embedded}}
<p class="info">
    <i class="fa-solid fa-circle-info" inert></i>
    {{localize "PF1.SpellCastingEmbeddedClass"}}
</p>
{{/if}}

<div class="form-group spellcasting-progression">
    <label>{{localize "PF1.Spellcasting.Progression.Label"}}</label>
    <div class="form-fields">
        <select name="flags.pf1-psionics.manifesting.progression" {{disabled @root.embedded}}>
            <option value="">{{localize "PF1.None"}}</option>
            {{selectOptions manifesting.progression selected=(lookup (lookup (lookup document.flags "pf1-psionics") "manifesting") "progression") localize=true}}
        </select>
    </div>
</div>

{{#if (lookup (lookup (lookup document.flags "pf1-psionics") "manifesting") "progression")}}
<div class="form-group spellcasting-ability">
    <label>{{localize "PF1.SpellcastingAbility"}}</label>
    <div class="form-fields">
        <select name="flags.pf1-psionics.manifesting.ability" {{disabled @root.embedded}}>
            {{selectOptions config.abilities selected=(lookup (lookup (lookup document.flags "pf1-psionics") "manifesting") "ability")}}
        </select>
    </div>
</div>

<div class="form-group spellcasting-cantrips">
    <label class="checkbox">
        <input type="checkbox" name="flags.pf1-psionics.manifesting.cantrips" {{checked (lookup (lookup (lookup document.flags "pf1-psionics") "manifesting") "cantrips")}} {{disabled @root.embedded}}>
        {{localize "PF1.HasCantrips"}}
    </label>
</div>

{{#unless hasManifester}}
<div class="form-group create-spellbook">
    <button name="create-manifester" type="button" {{disabled (not @root.editable)}}>
        <i class="fa-solid fa-book" inert></i>
        {{localize "PF1.CreateSpellbook"}}
    </button>
</div>
{{/unless}}
{{/if}}
